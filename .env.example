# Which implementation backs each AI seam.
# vehicle recognition: mock | openai | claude
# openai reuses OPENAI_API_KEY (a vision chat model, not gpt-image-2).
AI_PROVIDER=mock
# Vision model for recognition when AI_PROVIDER=openai.
VEHICLE_RECOGNITION_MODEL=gpt-4o-mini
# before/after inpainting: mock | provider   (provider = OpenAI gpt-image-2)
IMAGEGEN_PROVIDER=mock

# Only needed when AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# Only needed when IMAGEGEN_PROVIDER=provider
# OPENAI_API_KEY=sk-...
# Cost dial: low | medium | high | auto. Bigger max edge also costs more.
IMAGEGEN_QUALITY=medium
IMAGEGEN_MAX_EDGE=1024

# Telegram. Without a token the app still runs in a browser; bookings are then
# logged with a warning instead of reaching anyone.
# TELEGRAM_BOT_TOKEN=123456:AA...
# Where bookings are delivered — your own id, or a group/channel id (negative).
# TELEGRAM_MANAGER_CHAT_ID=
# Bot username without @, used by the "написать менеджеру" deep link.
# The button is hidden entirely when this is empty.
TELEGRAM_BOT_USERNAME=
# Set to 1 in production: /api/booking then refuses callers without valid
# initData. Keep 0 for browser development, where there is no initData at all.
TELEGRAM_REQUIRE_INIT_DATA=0

# Funnel analytics. An empty ADMIN_PASSWORD means /admin does not exist at all —
# it never means "reachable without a password".
ADMIN_PASSWORD=
ANALYTICS_ENABLED=1
ANALYTICS_TTL_DAYS=180

# Nothing may grow forever.
MEDIA_TTL_DAYS=7
JOB_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=60

# The only guard on spend: each generation is ~$0.05 against gpt-image-2.
# Separate from the try-on quota below: this is the abuse guard, that is the
# product rule.
GENERATION_LIMIT_PER_HOUR=20

# AI try-ons. Quotas apply to Telegram users only — a browser has no durable
# identity, so a quota there resets with localStorage and would be decoration.
QUOTA_ENABLED=1
FREE_TRIES_PER_CATEGORY=3
RESERVATION_TTL_MINUTES=15

# Referrals. A bonus is paid for a completed try-on by an invited person —
# never for a click, a bot start or a registration.
REFERRALS_ENABLED=1
REFERRAL_BONUS=1
REFERRAL_MONTHLY_LIMIT=10
REFERRAL_MIN_SECONDS=60
REFERRAL_FRAUD_THRESHOLD=4
# Mini-app short name from BotFather, for t.me/<bot>/<app>?startapp=...
# Leave empty and links fall back to t.me/<bot>?startapp=...
TELEGRAM_APP_NAME=

# One-time codes. A purchase both tops every category back up to full and
# grants bonuses; a visit only grants bonuses.
VISIT_BONUS=3
PURCHASE_BONUS=3
# Paid to the inviter when someone they brought completes a purchase — on top
# of the single bonus already paid for that person's first try-on.
REFERRED_CLIENT_BONUS=5
REWARD_CODE_VALID_DAYS=30
LOW_BALANCE_THRESHOLD=1

MEDIA_DIR=media
MAX_UPLOAD_MB=10

# Set to 1 to make the generation mock always fail, exercising the retry path.
GENERATION_FORCE_ERROR=0
